<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MusicStand"
             xmlns:inking="using:DotNetCampus.Inking"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MusicStand.MainView"
             xmlns:local="clr-namespace:MusicStand"
             x:DataType="vm:MainViewModel">
    <UserControl.Resources>
        <Flyout x:Key="StampFlyout" Placement="Bottom">
            <ListBox ItemsSource="{Binding StampCollection}"
                     SelectedItem="{Binding SelectedStamp}"
                     Height="550">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Viewbox Height="20" Stretch="Uniform">
                            <Path Data="{Binding Geometry}"
                                  Fill="{DynamicResource ToolbarIconForeground}"/>
                        </Viewbox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Flyout>
    </UserControl.Resources>
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->

        <DockPanel Grid.Row="0" Classes="toolbar" LastChildFill="False" HorizontalAlignment="Stretch" IsVisible="{Binding IsToolbarVisible}">
            <ToggleButton IsChecked="{Binding IsFileSelectMode}">
                <PathIcon
                    Data="M20 9.50195V8.74985C20 7.50721 18.9926 6.49985 17.75 6.49985H12.0247L9.64368 4.51995C9.23959 4.18393 8.73063 3.99997 8.20509 3.99997H4.24957C3.00724 3.99997 2 5.00686 1.99957 6.24919L1.99561 17.7492C1.99518 18.9921 3.00266 20 4.24561 20H4.27196C4.27607 20 4.28019 20 4.28431 20H18.4693C19.2723 20 19.9723 19.4535 20.167 18.6745L21.9169 11.6765C22.1931 10.5719 21.3577 9.50195 20.2192 9.50195H20ZM4.24957 5.49997H8.20509C8.38027 5.49997 8.54993 5.56129 8.68462 5.6733L11.2741 7.82652C11.4088 7.93852 11.5784 7.99985 11.7536 7.99985H17.75C18.1642 7.99985 18.5 8.33563 18.5 8.74985V9.50195H6.42385C5.39136 9.50195 4.49137 10.2047 4.241 11.2064L3.49684 14.1837L3.49957 6.24971C3.49971 5.8356 3.83546 5.49997 4.24957 5.49997ZM5.69623 11.5701C5.77969 11.2362 6.07969 11.002 6.42385 11.002H20.2192C20.3819 11.002 20.5012 11.1548 20.4617 11.3126L18.7119 18.3107C18.684 18.4219 18.584 18.5 18.4693 18.5H4.28431C4.12167 18.5 4.00233 18.3472 4.04177 18.1894L5.69623 11.5701Z"
                />
            </ToggleButton>
            <ToggleButton IsChecked="{Binding IsPenMode}">
                <PathIcon
                    Data="M27.3138 4.68622C28.8759 6.24832 28.8759 8.78098 27.3138 10.3431L12.5409 25.116C11.9001 25.7568 11.0972 26.2114 10.218 26.4312L5.63602 27.5767C4.90364 27.7598 4.24025 27.0964 4.42335 26.364L5.56885 21.782C5.78864 20.9028 6.24323 20.0999 6.88402 19.4591L21.6569 4.68622C23.219 3.12412 25.7517 3.12412 27.3138 4.68622ZM20.2426 8.92865L8.29824 20.8734C7.91376 21.2578 7.641 21.7396 7.50913 22.2671L6.76786 25.2322L9.73295 24.4909C10.2604 24.359 10.7422 24.0863 11.1267 23.7018L23.0706 11.7566L20.2426 8.92865ZM23.0712 6.10043L21.6566 7.51465L24.4846 10.3426L25.8996 8.92886C26.6806 8.14781 26.6806 6.88148 25.8996 6.10043C25.1185 5.31939 23.8522 5.31939 23.0712 6.10043Z"
                />
            </ToggleButton>
            <ToggleButton IsChecked="{Binding IsEraserMode}">
                <PathIcon
                    Data="M20,2.25 C20.3796958,2.25 20.693491,2.53215388 20.7431534,2.89822944 L20.75,3 L20.75,17 C20.75,19.5504817 18.7398587,21.6314697 16.217428,21.7451121 L16,21.75 L8,21.75 C5.44951834,21.75 3.36853034,19.7398587 3.25488786,17.217428 L3.25,17 L3.25,3.50170761 C3.25,3.08749405 3.58578644,2.75170761 4,2.75170761 C4.37969577,2.75170761 4.69349096,3.03386149 4.74315338,3.39993706 L4.75,3.50170761 L4.75,6.791 L19.25,6.791 L19.25,3 C19.25,2.58578644 19.5857864,2.25 20,2.25 Z M19.25,13.5 L4.75,13.5 L4.75,17 C4.75,18.7330315 6.10645477,20.1492459 7.81557609,20.2448552 L8,20.25 L16,20.25 C17.7330315,20.25 19.1492459,18.8935452 19.2448552,17.1844239 L19.25,17 L19.25,13.5 Z M19.25,8.291 L4.75,8.291 L4.75,12 L19.25,12 L19.25,8.291 Z"
                />
            </ToggleButton>
            <ToggleButton IsChecked="{Binding IsHighlighterMode}">
                <PathIcon
                    Data="M20.2585648,2.00438474 C20.6382605,2.00472706 20.9518016,2.28716326 21.0011348,2.65328337 L21.0078899,2.75506004 L21.0038407,7.25276883 C21.0009137,8.40908568 20.1270954,9.36072944 19.0029371,9.48671858 L19.0024932,11.7464847 C19.0024932,12.9373487 18.0773316,13.9121296 16.906542,13.9912939 L16.7524932,13.9964847 L16.501,13.9963847 L16.5017549,16.7881212 C16.5017549,17.6030744 16.0616895,18.349347 15.3600767,18.7462439 L15.2057929,18.8258433 L8.57108142,21.9321389 C8.10484975,22.1504232 7.57411944,21.8450614 7.50959937,21.3535767 L7.50306874,21.2528982 L7.503,13.9963847 L7.25,13.9964847 C6.05913601,13.9964847 5.08435508,13.0713231 5.00519081,11.9005335 L5,11.7464847 L5.00043957,9.4871861 C3.92882124,9.36893736 3.08392302,8.49812196 3.0058865,7.41488149 L3,7.25086975 L3,2.75438506 C3,2.3401715 3.33578644,2.00438474 3.75,2.00438474 C4.12969577,2.00438474 4.44349096,2.28653894 4.49315338,2.6526145 L4.5,2.75438506 L4.5,7.25086975 C4.5,7.63056552 4.78215388,7.94436071 5.14822944,7.99402313 L5.25,8.00086975 L18.7512697,8.00087075 C19.1315998,8.00025031 19.4461483,7.71759877 19.4967392,7.3518545 L19.5038434,7.25019537 L19.5078902,2.75371008 C19.508263,2.33949668 19.8443515,2.00401258 20.2585648,2.00438474 Z M15.001,13.9963847 L9.003,13.9963847 L9.00306874,20.0736262 L14.5697676,17.4673619 C14.8004131,17.3593763 14.9581692,17.1431606 14.9940044,16.89581 L15.0017549,16.7881212 L15.001,13.9963847 Z M17.502,9.50038474 L6.5,9.50038474 L6.5,11.7464847 C6.5,12.1261805 6.78215388,12.4399757 7.14822944,12.4896381 L7.25,12.4964847 L16.7524932,12.4964847 C17.1321889,12.4964847 17.4459841,12.2143308 17.4956465,11.8482552 L17.5024932,11.7464847 L17.502,9.50038474 Z"
                />
            </ToggleButton>
            <ToggleButton Content="{Binding SelectedStamp}" IsChecked="{Binding IsStampMode}" Click="OnStampButtonClick">
                <ToggleButton.ContentTemplate>
                    <DataTemplate DataType="vm:Stamp">
                        <PathIcon Data="{Binding Geometry}"/>
                    </DataTemplate>
                </ToggleButton.ContentTemplate>
            </ToggleButton>
            <ToggleButton IsChecked="{Binding IsTextStampMode}" ToolTip.Tip="Stamp text on the page">
                <PathIcon
                    Data="M15 8.5H12.75V15.5H13.25C13.6642 15.5 14 15.8358 14 16.25C14 16.6642 13.6642 17 13.25 17H10.75C10.3358 17 10 16.6642 10 16.25C10 15.8358 10.3358 15.5 10.75 15.5H11.25V8.5H9V9.2501C9 9.66432 8.66421 10.0001 8.25 10.0001C7.83579 10.0001 7.5 9.66432 7.5 9.2501V7.75C7.5 7.33579 7.83579 7 8.25 7H15.75C16.1642 7 16.5 7.33579 16.5 7.75V9.2501C16.5 9.66432 16.1642 10.0001 15.75 10.0001C15.3358 10.0001 15 9.66432 15 9.2501V8.5Z M5.75 4C3.67893 4 2 5.67893 2 7.75V16.25C2 18.3211 3.67893 20 5.75 20H18.25C20.3211 20 22 18.3211 22 16.25V7.75C22 5.67893 20.3211 4 18.25 4H5.75ZM3.5 7.75C3.5 6.50736 4.50736 5.5 5.75 5.5H18.25C19.4926 5.5 20.5 6.50736 20.5 7.75V16.25C20.5 17.4926 19.4926 18.5 18.25 18.5H5.75C4.50736 18.5 3.5 17.4926 3.5 16.25V7.75Z"
                />
            </ToggleButton>
            <TextBox Text="{Binding TextStamp}"
                     PlaceholderText="Text to stamp"
                     Width="180"
                     VerticalAlignment="Center"
                     IsVisible="{Binding IsTextStampMode}"/>
            <ToggleButton Content="{Binding SelectedBrush}">
                <ToggleButton.ContentTemplate>
                    <DataTemplate DataType="IBrush">
                        <Ellipse Fill="{Binding .}" Width="35" Height="35"/>
                    </DataTemplate>
                </ToggleButton.ContentTemplate>
                <ToggleButton.Flyout>
                    <Flyout Placement="Bottom">
                        <ListBox ItemsSource="{Binding SolidColorBrushCollection}"
                                 SelectedItem="{Binding SelectedBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="IBrush">
                                    <Ellipse Fill="{Binding .}" Width="35" Height="35"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Flyout>
                </ToggleButton.Flyout>
            </ToggleButton>
            <Separator Height="NaN" Width="1"/>
            <!-- Setlist buttons -->
            <ToggleButton IsChecked="{Binding IsSetListMode}">
                <PathIcon
                    Data="M14.4373398,3.10348696 C14.6345524,3.20081719 14.7941799,3.36044472 14.8915102,3.55765732 L17.8153782,9.48206111 L24.353346,10.4320834 C24.8998908,10.511501 25.2785723,11.0189439 25.1991547,11.5654888 C25.1675302,11.7831258 25.065043,11.9842682 24.9075593,12.1377768 L20.1766414,16.749282 L21.2934597,23.2608319 C21.3868207,23.8051684 21.0212328,24.3221243 20.4768964,24.4154853 C20.2601388,24.4526621 20.0371707,24.4173475 19.8425102,24.3150084 L13.9947741,21.2406716 L8.14703796,24.3150084 C7.65819337,24.5720092 7.05356621,24.3840627 6.79656541,23.8952181 C6.69422634,23.7005576 6.65891166,23.4775895 6.69608851,23.2608319 L7.81290673,16.749282 L3.08198882,12.1377768 C2.68650524,11.7522756 2.67841294,11.1191623 3.06391415,10.7236788 C3.21742275,10.5661951 3.41856517,10.4637079 3.6362022,10.4320834 L10.1741699,9.48206111 L13.098038,3.55765732 C13.3424603,3.06240366 13.9420861,2.85906466 14.4373398,3.10348696 Z M11.1702682,10.8530728 L4.85448108,11.7708103 L9.42462758,16.2256022 L8.34576234,22.5158692 L13.9947741,19.546008 L19.6437858,22.5158692 L18.5649206,16.2256022 L23.1350671,11.7708103 L16.81928,10.8530728 L13.9947741,5.12999876 L11.1702682,10.8530728 Z"
                />
            </ToggleButton>            

            <!-- Close button -->
            <ToggleButton Content="X" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsChecked="{Binding IsToolbarVisible}" DockPanel.Dock="Right" MinWidth="50"/>
        </DockPanel>

        <!-- Content area -->

        <local:PDFCanvas x:Name="PDFCanvas"
                         Grid.Row="1"
                         IsVisible="{Binding IsPDFCanvasVisible}" />

        <Border Grid.Row="1"
                ZIndex="1"
                Width="800"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                IsVisible="{Binding IsSetListMode}">
            <local:SetLists/>
        </Border>

        <Border Grid.Row="1"
                ZIndex="1"
                Width="400"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                IsVisible="{Binding IsFileSelectMode}">
            <local:FileSelect />
        </Border>
    </Grid>
</UserControl>
