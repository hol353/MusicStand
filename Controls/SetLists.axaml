<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicStand"
             xmlns:local="clr-namespace:MusicStand"
             x:Class="MusicStand.SetLists"
             x:DataType="vm:MainViewModel">
    <Grid ColumnDefinitions="400, 400">

        <DockPanel Grid.Column="0"
                   LastChildFill="True"
                   Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <ComboBox DockPanel.Dock="Top" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding SetLists.SetListNames}" 
                      SelectedItem="{Binding SetLists.SelectedName}" />
            <StackPanel DockPanel.Dock="Top" Classes="toolbar" Orientation="Horizontal" HorizontalAlignment="Stretch">
                <!-- Show set list -->
                <Button Command="{Binding SetLists.ShowMusic}">
                    <PathIcon Data="M11.5,2.75 C11.5,2.22634895 12.0230228,1.86388952 12.5133347,2.04775015 L18.8913911,4.43943933 C20.1598961,4.91511241 21.0002742,6.1277638 21.0002742,7.48252202 L21.0002742,10.7513533 C21.0002742,11.2750044 20.4772513,11.6374638 19.9869395,11.4536032 L13,8.83332147 L13,17.5 C13,17.5545945 12.9941667,17.6078265 12.9830895,17.6591069 C12.9940859,17.7709636 13,17.884807 13,18 C13,20.2596863 10.7242052,22 8,22 C5.27579485,22 3,20.2596863 3,18 C3,15.7403137 5.27579485,14 8,14 C9.3521238,14 10.5937815,14.428727 11.5015337,15.1368931 L11.5,2.75 Z M8,15.5 C6.02978478,15.5 4.5,16.6698354 4.5,18 C4.5,19.3301646 6.02978478,20.5 8,20.5 C9.97021522,20.5 11.5,19.3301646 11.5,18 C11.5,16.6698354 9.97021522,15.5 8,15.5 Z M13,3.83223733 L13,7.23159672 L19.5002742,9.669116 L19.5002742,7.48252202 C19.5002742,6.75303682 19.0477629,6.10007069 18.3647217,5.84393903 L13,3.83223733 Z"/>      
                </Button>

                <!-- Create new set list -->
                <ToggleButton IsChecked="{Binding SetLists.IsCreatingNewSetList}"> 
                    <PathIcon Data="M13.25,17.5 C13.6642,17.5 14,17.8358 14,18.25 C14,18.6642 13.6642,19 13.25,19 L4.75,19 C4.33579,19 4,18.6642 4,18.25 C4,17.8358 4.33579,17.5 4.75,17.5 L13.25,17.5 Z M7.21967,7.21967 C7.48593364,6.95340636 7.90260223,6.92920058 8.19621222,7.14705264 L8.28033,7.21967 L14.7803,13.7197 C15.0732,14.0126 15.0732,14.4874 14.7803,14.7803 C14.5140273,15.0465727 14.097424,15.0707793 13.8038184,14.8529198 L13.7197,14.7803 L7.21967,8.28033 C6.92678,7.98744 6.92678,7.51256 7.21967,7.21967 Z M18.25,4 C18.6642,4 19,4.33579 19,4.75 L19,13.25 C19,13.6642 18.6642,14 18.25,14 C17.8358,14 17.5,13.6642 17.5,13.25 L17.5,4.75 C17.5,4.33579 17.8358,4 18.25,4 Z" />
                </ToggleButton>
                <TextBox PlaceholderText="New set list name" 
                         IsVisible="{Binding SetLists.IsCreatingNewSetList}"
                         Text="{Binding SetLists.NewSetListName, UpdateSourceTrigger=LostFocus}" 
                         />                

                <!-- Toggle file list -->                    
                <ToggleButton IsChecked="{Binding SetLists.IsFileListVisible}">  
                    <PathIcon
                        Data="M14.5,13 L14.5,3.75378577 C14.5,3.33978577 14.164,3.00378577 13.75,3.00378577 C13.336,3.00378577 13,3.33978577 13,3.75378577 L13,13 L3.75387573,13 C3.33987573,13 3.00387573,13.336 3.00387573,13.75 C3.00387573,14.164 3.33987573,14.5 3.75387573,14.5 L13,14.5 L13,23.7523651 C13,24.1663651 13.336,24.5023651 13.75,24.5023651 C14.164,24.5023651 14.5,24.1663651 14.5,23.7523651 L14.5,14.5 L23.7498262,14.5030754 C24.1638262,14.5030754 24.4998262,14.1670754 24.4998262,13.7530754 C24.4998262,13.3390754 24.1638262,13.0030754 23.7498262,13.0030754 L14.5,13 Z"
                    />
                </ToggleButton> 
            </StackPanel>
            <Grid>
                <ListBox x:Name="SetListFilesList" ItemsSource="{Binding SetLists.SelectedSetListTitles}" />
                <Border x:Name="DropIndicator"
                        Height="3"
                        Margin="8,0"
                        VerticalAlignment="Top"
                        Background="{DynamicResource ToolbarIconForeground}"
                        CornerRadius="2"
                        IsHitTestVisible="False"
                        IsVisible="False"/>
            </Grid>
        </DockPanel>

        <Border Grid.Column="1"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                IsVisible="{Binding SetLists.IsFileListVisible}">
            <local:FileSelect/>
        </Border>        
    </Grid>
</UserControl>
