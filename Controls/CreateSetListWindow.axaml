<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MusicStand.CreateSetListWindow"
        Title="Create setlist"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="Filename (without extension):"/>
        <TextBox x:Name="FileNameTextBox"
                 PlaceholderText="Setlist name"
                 KeyDown="OnFileNameKeyDown"/>
        <TextBlock x:Name="ErrorTextBlock"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   IsVisible="False"/>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Content="Cancel" Click="OnCancelClick"/>
            <Button Content="OK" Click="OnOkClick"/>
        </StackPanel>
    </StackPanel>
</Window>
